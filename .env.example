# Copy to .env.local and fill in. Never commit real keys.
# Every variable is optional: without a key the demo runs on its offline rules engine.

# Google Gemini API key for the LLM steps (company intake, skills translator, evidence mapping).
# Get one at https://aistudio.google.com/apikey. GOOGLE_API_KEY also works.
GEMINI_API_KEY=

# Gemini model to use. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Set to "rules" to force the offline rules engine even when a key is set (useful for demos without network).
# AI_MODE=rules
