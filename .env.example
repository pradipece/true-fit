# Copy to .env.local and fill in. Never commit real keys.
# Every variable is optional: without a key the demo runs on its offline rules engine.

# Google Gemini API key for the LLM steps (company intake, skills translator, evidence mapping).
# Get one at https://aistudio.google.com/apikey. GOOGLE_API_KEY also works.
GEMINI_API_KEY=

# Gemini model to use. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Set to "rules" to force the offline rules engine even when a key is set (useful for demos without network).
# AI_MODE=rules

# Supabase Postgres for the seed data (companies, needs, talent). Without these the app
# runs on data/seed/*.json. Load the database with `yarn db:migrate`.
# The server connects through the IPv4 session pooler as postgres.<project-ref>, with TLS
# verified against Supabase's root CA. Pooler host: Supabase dashboard → Connect → Session pooler.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_DATABASE_PASSWORD=
# SUPABASE_POOLER_HOST=aws-1-eu-west-2.pooler.supabase.com
# Or instead a full connection string (sslmode is ignored; TLS is always verified):
# SUPABASE_DATABASE_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
